        <mxCell id="TBkUA1SfxO7D3SP7PxQp-1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0a30a;strokeColor=#BD7000;align=center;spacingLeft=4;spacingRight=4;spacingTop=4;spacingBottom=4;fontColor=#FFFFFF;" value="&lt;p&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;Данные управления автоматикой в помещениях (коды доступа, пароли контроллеров и т.п.), схемы инженерных сетей ЖК&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;b&gt;Риски:&lt;/b&gt;&amp;nbsp;&lt;span style=&quot;background-color: transparent;&quot;&gt;искажение,&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;утечка, потеря&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;b&gt;Оценка рисков:&lt;/b&gt; критический&lt;/p&gt;" vertex="1">
          <mxGeometry height="160" width="240" x="510" y="210" as="geometry" />
        </mxCell>
        <mxCell id="TBkUA1SfxO7D3SP7PxQp-2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0050ef;strokeColor=#001DBC;align=center;spacingLeft=4;spacingRight=4;spacingTop=4;spacingBottom=4;fontColor=#FFFFFF;" value="&lt;p&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;Данные могут быть использованы для кибератак, может быть создана угроза здоровью и жизни собственников&lt;/span&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="160" width="280" x="830" y="210" as="geometry" />
        </mxCell>
        <mxCell id="nkZw3uwRARFWO6aR3YEc-16" edge="1" parent="1" source="nkZw3uwRARFWO6aR3YEc-2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=1;entryDx=0;entryDy=0;defaultLabelBackgroundColor=page;" target="nkZw3uwRARFWO6aR3YEc-3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="nkZw3uwRARFWO6aR3YEc-2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1ba1e2;strokeColor=#006EAF;align=center;spacingLeft=4;spacingRight=4;spacingTop=4;spacingBottom=4;fontColor=#FFFFFF;" value="&lt;p&gt;Д&lt;span style=&quot;background-color: transparent;&quot;&gt;анные о записях онлайн-туров, данные о фактическом прохождении туров клиентами (&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;логи сессий, время просмотра)&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;b&gt;Риски:&lt;/b&gt; потеря, искажение&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;b&gt;Оценка рисков:&lt;/b&gt; значительный&lt;/p&gt;" vertex="1">
          <mxGeometry height="160" width="240" x="224" y="-160" as="geometry" />
        </mxCell>
        <mxCell id="nkZw3uwRARFWO6aR3YEc-3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0050ef;strokeColor=#001DBC;align=center;spacingLeft=4;spacingRight=4;spacingTop=4;spacingBottom=4;fontColor=#ffffff;fontStyle=0" value="&lt;p&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;span&gt;Д&lt;/span&gt;анные используются как инструмент маркетинга и анализа, их потеря или искажение могут привести к неверным бизнес-решениям&lt;/span&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="160" width="280" x="204" y="-400" as="geometry" />
        </mxCell>
        <mxCell id="nkZw3uwRARFWO6aR3YEc-15" edge="1" parent="1" source="nkZw3uwRARFWO6aR3YEc-5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=1;entryDx=0;entryDy=0;defaultLabelBackgroundColor=page;" target="nkZw3uwRARFWO6aR3YEc-6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="nkZw3uwRARFWO6aR3YEc-5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1ba1e2;strokeColor=#006EAF;align=center;spacingLeft=4;spacingRight=4;spacingTop=4;spacingBottom=4;fontColor=#FFFFFF;" value="&lt;p&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;Технические данные для управления автоматизацией (ID устройств, состояния - без привязки к владельцу)&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;b&gt;Риски:&lt;/b&gt; потеря, искажение&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;b&gt;Оценка рисков:&lt;/b&gt; критический&lt;/p&gt;" vertex="1">
          <mxGeometry height="160" width="240" x="-460" y="-160" as="geometry" />
        </mxCell>
        <mxCell id="nkZw3uwRARFWO6aR3YEc-6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0050ef;strokeColor=#001DBC;align=center;spacingLeft=4;spacingRight=4;spacingTop=4;spacingBottom=4;fontColor=#FFFFFF;" value="&lt;p&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;При потере высок риск кибер атак&lt;/span&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="160" width="280" x="-480" y="-400" as="geometry" />
        </mxCell>
        <mxCell id="nkZw3uwRARFWO6aR3YEc-9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0050ef;strokeColor=#001DBC;align=center;spacingLeft=4;spacingRight=4;spacingTop=4;spacingBottom=4;fontColor=#FFFFFF;textShadow=1;" value="&lt;p&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;Данные могут использоваться как подотчетная информация, а так же предоставляться при разрешении споров, их потеря/искажение может привести к финансовым потерям&lt;/span&gt;&lt;/p&gt;" vertex="1">
