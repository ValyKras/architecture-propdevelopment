        <mxCell id="nkZw3uwRARFWO6aR3YEc-12" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0050ef;strokeColor=#001DBC;align=center;spacingLeft=4;spacingRight=4;spacingTop=4;spacingBottom=4;fontColor=#ffffff;" value="&lt;p&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;Искажение BI-отчетности может привести к неверным решениям на уровне менеджмента и неверным бизнес-решениям&lt;/span&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="160" width="280" x="547" y="-400" as="geometry" />
        </mxCell>
        <mxCell id="nkZw3uwRARFWO6aR3YEc-14" edge="1" parent="1" source="nkZw3uwRARFWO6aR3YEc-13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;defaultLabelBackgroundColor=page;" target="nkZw3uwRARFWO6aR3YEc-9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="nkZw3uwRARFWO6aR3YEc-13" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1ba1e2;strokeColor=#006EAF;align=center;spacingLeft=4;spacingRight=4;spacingTop=4;spacingBottom=4;fontColor=#FFFFFF;" value="&lt;p&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;История капитальных ремонтов (без персональных данных)&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;b&gt;Риски:&lt;/b&gt; потеря, искажение&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;b&gt;Оценка рисков:&lt;/b&gt; значительный&lt;/p&gt;" vertex="1">
          <mxGeometry height="160" width="240" x="-123" y="-160" as="geometry" />
        </mxCell>
        <mxCell id="_Llgm-G9-Wrz7oqu-sRn-9" edge="1" parent="1" source="_Llgm-G9-Wrz7oqu-sRn-2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=1;entryY=0.5;entryDx=0;entryDy=0;defaultLabelBackgroundColor=page;" target="_Llgm-G9-Wrz7oqu-sRn-3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_Llgm-G9-Wrz7oqu-sRn-2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#60a917;strokeColor=#2D7600;align=center;spacingLeft=4;spacingRight=4;spacingTop=4;spacingBottom=4;fontColor=#ffffff;" value="&lt;p&gt;&lt;b&gt;Р&lt;/b&gt;еестр объектов недвижимости (фотографии, описания, цены)&lt;/p&gt;&lt;p&gt;&lt;b&gt;Риски:&lt;/b&gt; потеря, искажение, обесценивание, некачественные данные&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;b&gt;Оценка рисков:&lt;/b&gt; значительный&lt;/p&gt;" vertex="1">
          <mxGeometry height="160" width="240" x="-490" y="90" as="geometry" />
        </mxCell>
        <mxCell id="_Llgm-G9-Wrz7oqu-sRn-3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0050ef;strokeColor=#001DBC;align=center;spacingLeft=4;spacingRight=4;spacingTop=4;spacingBottom=4;fontColor=#FFFFFF;" value="&lt;p&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;Потеря/искажение данных ведет к снижению продаж, а так же потере репутации компании.&amp;nbsp;&lt;/span&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="160" width="280" x="-870" y="90" as="geometry" />
        </mxCell>
        <mxCell id="_Llgm-G9-Wrz7oqu-sRn-10" edge="1" parent="1" source="_Llgm-G9-Wrz7oqu-sRn-5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=1;entryY=0.5;entryDx=0;entryDy=0;defaultLabelBackgroundColor=page;" target="_Llgm-G9-Wrz7oqu-sRn-6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_Llgm-G9-Wrz7oqu-sRn-5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#60a917;strokeColor=#2D7600;align=center;spacingLeft=4;spacingRight=4;spacingTop=4;spacingBottom=4;fontColor=#FFFFFF;" value="&lt;p&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;b&gt;Ин&lt;/b&gt;формация от управляющей компании (новости, объявления о ремонтах)&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;b&gt;Риски:&lt;/b&gt; потеря, искажение, обесценивание&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;b&gt;Оценка рисков:&lt;/b&gt;&amp;nbsp;незначительный&lt;/p&gt;" vertex="1">
          <mxGeometry height="160" width="240" x="-490" y="310" as="geometry" />
        </mxCell>
        <mxCell id="_Llgm-G9-Wrz7oqu-sRn-6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0050ef;strokeColor=#001DBC;align=center;spacingLeft=4;spacingRight=4;spacingTop=4;spacingBottom=4;fontColor=#FFFFFF;" value="&lt;p&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;b&gt;С&lt;/b&gt;корее всего, информация дублируется на информационных стендах в самих ЖК и недостоверность/искажение ее не приведую к серьезным последствиям&lt;/span&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="160" width="280" x="-870" y="310" as="geometry" />
        </mxCell>
        <mxCell id="_Llgm-G9-Wrz7oqu-sRn-8" edge="1" parent="1" source="lFXcrGgAb-YwopAgYgY4-6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.998;entryY=0.563;entryDx=0;entryDy=0;entryPerimeter=0;defaultLabelBackgroundColor=page;" target="_Llgm-G9-Wrz7oqu-sRn-5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cLDhWxOMd8VhWZgQQxSF-3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0050ef;strokeColor=#001DBC;align=center;spacingLeft=4;spacingRight=4;spacingTop=4;spacingBottom=4;fontColor=#FFFFFF;fontStyle=0" value="&lt;p&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;span&gt;Потеря или утечка данных является п&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;рямым нарушением 152-ФЗ. Утечка приведет к штрафам и потере доверия клиентов. При потере данных&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;компания не сможет оказывать услуги ни по продаже, ни по ЖКХ&lt;/span&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="160" width="280" x="-300" y="760" as="geometry" />
        </mxCell>
        <mxCell id="cLDhWxOMd8VhWZgQQxSF-13" edge="1" parent="1" source="cLDhWxOMd8VhWZgQQxSF-5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;defaultLabelBackgroundColor=page;" target="cLDhWxOMd8VhWZgQQxSF-6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cLDhWxOMd8VhWZgQQxSF-5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e51400;strokeColor=#B20000;align=center;spacingLeft=4;spacingRight=4;spacingTop=4;spacingBottom=4;fontColor=#FFFFFF;fontStyle=0" value="&lt;p&gt;&lt;span&gt;Д&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;анные о сделках и участниках (сумма, условия, договоры, персональные данные и тд)&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span&gt;Риски:&lt;/span&gt;&amp;nbsp;искажение, утечка&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;span&gt;Оценка рисков:&lt;/span&gt; критический&lt;/p&gt;" vertex="1">
          <mxGeometry height="160" width="240" x="420" y="520" as="geometry" />
        </mxCell>
        <mxCell id="cLDhWxOMd8VhWZgQQxSF-6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0050ef;strokeColor=#001DBC;align=center;spacingLeft=4;spacingRight=4;spacingTop=4;spacingBottom=4;fontStyle=0;fontColor=#FFFFFF;" value="&lt;p&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;span&gt;Утечка данных договор и клиентов, а так же искажение номеров расчетов и условий сделок приведут к финансовому и репутационному ущербам&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="160" width="280" x="400" y="750" as="geometry" />
        </mxCell>
        <mxCell id="cLDhWxOMd8VhWZgQQxSF-12" edge="1" parent="1" source="cLDhWxOMd8VhWZgQQxSF-8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;defaultLabelBackgroundColor=page;" target="cLDhWxOMd8VhWZgQQxSF-9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cLDhWxOMd8VhWZgQQxSF-8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e51400;strokeColor=#B20000;align=center;spacingLeft=4;spacingRight=4;spacingTop=4;spacingBottom=4;fontColor=#FFFFFF;" value="&lt;p&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;b&gt;Ф&lt;/b&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;инансовые данные (платежные реквизиты, история оплат ЖКХ по конкретным счетам)&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;b&gt;Риски:&lt;/b&gt;&amp;nbsp;некачественные данные, потеря, искажение&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;b&gt;Оценка рисков:&lt;/b&gt; значительный&lt;/p&gt;" vertex="1">
          <mxGeometry height="160" width="240" x="60" y="520" as="geometry" />
        </mxCell>
        <mxCell id="cLDhWxOMd8VhWZgQQxSF-9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0050ef;strokeColor=#001DBC;align=center;spacingLeft=4;spacingRight=4;spacingTop=4;spacingBottom=4;fontColor=#FFFFFF;fontStyle=0" value="&lt;p&gt;&lt;span&gt;О&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;шибки в платежных реквизитах приведут к потере репутации, массовых жалобах. Ошибки при начислении ЖКХ вызовут массовые обращения в управляющую компанию&lt;/span&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="160" width="280" x="40" y="760" as="geometry" />
        </mxCell>
        <mxCell id="cLDhWxOMd8VhWZgQQxSF-11" edge="1" parent="1" source="cLDhWxOMd8VhWZgQQxSF-10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;defaultLabelBackgroundColor=page;" target="cLDhWxOMd8VhWZgQQxSF-3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cLDhWxOMd8VhWZgQQxSF-10" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e51400;strokeColor=#B20000;align=center;spacingLeft=4;spacingRight=4;spacingTop=4;spacingBottom=4;fontColor=#ffffff;" value="&lt;p&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;Персональные данные клиентов и собственников (ФИО, телефон, паспортные данные, адрес)&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;b&gt;Риски:&lt;/b&gt;&amp;nbsp;утечка, потеря&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;b&gt;Оценка рисков:&lt;/b&gt; критический&lt;/p&gt;" vertex="1">
          <mxGeometry height="160" width="240" x="-280" y="520" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
